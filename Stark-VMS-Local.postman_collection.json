{
  "info": {
    "_postman_id": "e0d2f1a8-54b6-47a1-9cc7-f4d0dbf571b4",
    "name": "Stark VMS Local API",
    "description": "Local collection for the Stark VMS Backend API. Register and log in first; the login request saves the bearer token for protected requests. A fresh test email and vehicle number are generated for each run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "serverOrigin",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "emailPrefix",
      "value": "postman-test",
      "type": "string"
    },
    {
      "key": "registeredEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "fullName",
      "value": "Postman Local Tester",
      "type": "string"
    },
    {
      "key": "password",
      "value": "secret123",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicleNumber",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverOrigin}}/actuator/health",
            "description": "Public health endpoint. Expected: 200 with {\"status\":\"UP\"}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health endpoint is UP', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const prefix = pm.collectionVariables.get('emailPrefix') || 'postman-test';",
                  "pm.collectionVariables.set('registeredEmail', prefix + '.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns a safe user without a token', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.have.property('id');",
                  "  pm.expect(body.data.email).to.eql(pm.collectionVariables.get('registeredEmail'));",
                  "  pm.expect(body.data).not.to.have.property('accessToken');",
                  "  pm.expect(body.data).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates a new local test account and stores a unique email for the following login request. Registration returns the user only; it does not issue a token."
          }
        },
        {
          "name": "Duplicate registration (expected 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate email returns 409 error envelope', function () {",
                  "  pm.response.to.have.status(409);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.be.a('string');",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Run after Register test user. Reuses its email and should return 409."
          }
        },
        {
          "name": "Login test user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns nested bearer token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.data.expiresIn).to.be.a('number');",
                  "  pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('registeredEmail'));",
                  "  pm.expect(body.data).not.to.have.property('refreshToken');",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{registeredEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Uses the account created above and saves data.accessToken as the collection bearer token for later requests."
          }
        },
        {
          "name": "Invalid registration data (expected 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid registration returns field errors', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.fieldErrors).to.be.an('object');",
                  "  pm.expect(body.fieldErrors.email).to.be.a('string');",
                  "  pm.expect(body.fieldErrors.password).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Invalid Postman User\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Negative validation check. The invalid request should not create an account."
          }
        },
        {
          "name": "Invalid login (expected 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid credentials return generic 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.eql('Invalid email or password.');",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"missing.user@example.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Negative check: invalid credentials should return the same generic message regardless of whether an account exists."
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List vehicles (page 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Vehicle list returns a page', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.content).to.be.an('array');",
                  "  pm.expect(data.page).to.eql(0);",
                  "  pm.expect(data.size).to.eql(10);",
                  "  pm.expect(data.totalElements).to.be.a('number');",
                  "  pm.expect(data.totalPages).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehicles?page=0&size=10",
            "description": "Requires the token saved by Login test user. Optional query parameters: search, status, page, and size. Status values are exactly Active, In Service, or Inactive."
          }
        },
        {
          "name": "List vehicles (search and status filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered vehicle list returns a page', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.content).to.be.an('array');",
                  "  pm.expect(data.page).to.eql(0);",
                  "  pm.expect(data.size).to.eql(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehicles?search=postman&status=Active&page=0&size=10",
            "description": "Search is a case-insensitive substring match over vehicleNumber, companyName, brand, and model; status is an exact filter."
          }
        },
        {
          "name": "Create test vehicle",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('vehicleNumber', 'POSTMAN-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Vehicle is created with metadata', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.id).to.be.a('number');",
                  "  pm.expect(body.data.createdAt).to.be.a('string');",
                  "  pm.expect(body.data.updatedAt).to.be.a('string');",
                  "  pm.collectionVariables.set('vehicleNumber', body.data.vehicleNumber);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"{{vehicleNumber}}\",\n  \"companyName\": \"Postman Test Fleet\",\n  \"vehicleType\": \"Van\",\n  \"brand\": \"TestBrand\",\n  \"model\": \"Local Tester\",\n  \"status\": \"Active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/vehicles",
            "description": "Creates a uniquely numbered local test vehicle. The script saves its normalized vehicleNumber for the following read/update/delete requests."
          }
        },
        {
          "name": "Duplicate vehicle create (expected 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate vehicle number returns 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"{{vehicleNumber}}\",\n  \"companyName\": \"Postman Duplicate Check\",\n  \"vehicleType\": \"Van\",\n  \"brand\": \"TestBrand\",\n  \"model\": \"Duplicate\",\n  \"status\": \"Active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/vehicles",
            "description": "Run after Create test vehicle; expects a 409 conflict and leaves the original record unchanged."
          }
        },
        {
          "name": "Read test vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Vehicle can be retrieved by number', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.vehicleNumber).to.eql(pm.collectionVariables.get('vehicleNumber'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehicles/{{vehicleNumber}}",
            "description": "Run after Create test vehicle. Vehicle numbers with spaces or punctuation must be URL-encoded as a single path segment."
          }
        },
        {
          "name": "Update test vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Vehicle update preserves its ID and changes fields', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.vehicleNumber).to.eql(pm.collectionVariables.get('vehicleNumber'));",
                  "  pm.expect(data.companyName).to.eql('Postman Test Fleet Updated');",
                  "  pm.expect(data.status).to.eql('In Service');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"{{vehicleNumber}}\",\n  \"companyName\": \"Postman Test Fleet Updated\",\n  \"vehicleType\": \"Van\",\n  \"brand\": \"TestBrand\",\n  \"model\": \"Local Tester Updated\",\n  \"status\": \"In Service\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/vehicles/{{vehicleNumber}}",
            "description": "Run after Create test vehicle. The path identifies the existing/original vehicle number, while the body supplies its new data."
          }
        },
        {
          "name": "Delete test vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Vehicle is deleted successfully', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/vehicles/{{vehicleNumber}}",
            "description": "Run last; deletes the test vehicle created by this collection."
          }
        },
        {
          "name": "Read missing vehicle (expected 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing vehicle returns standard 404 error', function () {",
                  "  pm.response.to.have.status(404);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehicles/POSTMAN-DOES-NOT-EXIST",
            "description": "Negative check: missing vehicle should return 404 with the standard error envelope."
          }
        },
        {
          "name": "Invalid status filter (expected 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unsupported status returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vehicles?status=active",
            "description": "Status is case-sensitive. Valid values are Active, In Service, and Inactive."
          }
        },
        {
          "name": "Unauthenticated vehicle request (expected 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Protected route rejects missing bearer token', function () {",
                  "  pm.response.to.have.status(401);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/vehicles",
            "description": "Negative security check; this request explicitly disables the collection bearer token and should return 401."
          }
        },
        {
          "name": "Invalid bearer token (expected 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Malformed bearer token is rejected', function () {",
                  "  pm.response.to.have.status(401);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-valid-jwt"
              }
            ],
            "url": "{{baseUrl}}/vehicles",
            "description": "Negative security check for a malformed JWT."
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard returns database counts', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.totalVehicles).to.be.a('number');",
                  "  pm.expect(data.activeVehicles).to.be.a('number');",
                  "  pm.expect(data.inServiceVehicles).to.be.a('number');",
                  "  pm.expect(data.inactiveVehicles).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/stats",
            "description": "Requires a bearer token. Counts reflect current database rows and will depend on your local data."
          }
        }
      ]
    },
    {
      "name": "CORS",
      "item": [
        {
          "name": "Allowed local preflight",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Configured local origin is allowed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('http://localhost:3000');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:3000"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ],
            "url": "{{baseUrl}}/vehicles",
            "description": "Checks the default configured local Flutter Web origin. Update Origin if VMS_CORS_ALLOWED_ORIGINS uses a different frontend origin. Postman itself does not enforce browser CORS; this request inspects the server's preflight response."
          }
        },
        {
          "name": "Rejected unconfigured preflight (expected 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unconfigured origin is rejected', function () {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.be.oneOf([undefined, null]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Origin",
                "value": "https://not-configured.example"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": "{{baseUrl}}/vehicles",
            "description": "Negative preflight check; expected 403 without Access-Control-Allow-Origin."
          }
        }
      ]
    }
  ]
}
