SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stark_vms
SPRING_DATASOURCE_USERNAME=your_local_postgres_user
SPRING_DATASOURCE_PASSWORD=replace_me
VMS_JWT_SECRET=base64_encoded_random_value_at_least_32_bytes
VMS_JWT_ACCESS_TOKEN_LIFETIME=PT24H
APP_SEED_DEMO_DATA=false
VMS_DEMO_PASSWORD=
# Local development only; for Render replace these with the exact Netlify site origin.
VMS_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
VMS_BUSINESS_TIME_ZONE=Asia/Dhaka
# Use the full S3 endpoint and region shown in Supabase Storage > Configuration > S3.
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<region-from-supabase-s3-settings>
SUPABASE_S3_ACCESS_KEY_ID=
# Server-only. Do not commit or share this key.
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SIGNED_URL_TTL_SECONDS=300
