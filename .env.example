SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stark_vms
SPRING_DATASOURCE_USERNAME=your_local_postgres_user
SPRING_DATASOURCE_PASSWORD=replace_me
VMS_JWT_SECRET=base64_encoded_random_value_at_least_32_bytes
VMS_JWT_ACCESS_TOKEN_LIFETIME=PT24H
APP_SEED_DEMO_DATA=false
VMS_DEMO_PASSWORD=
# Local development only; for Render replace these with the exact Netlify site origin.
VMS_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
